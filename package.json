{
	"name": "@skeletonlabs/monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"doc": "pnpm --filter @skeletonlabs/skeleton.dev",
		"themes": "pnpm --filter @skeletonlabs/themes.skeleton.dev",
		"plus": "pnpm --filter @skeletonlabs/plus.skeleton.dev",
		"svelte": "pnpm --filter @skeletonlabs/playground-skeleton-svelte",
		"react": "pnpm --filter @skeletonlabs/playground-skeleton-react",
		"test": "vp test run",
		"check": "pnpm --recursive --aggregate-output --reporter=append-only --parallel check",
		"format": "vp fmt .",
		"format:check": "vp fmt . --check",
		"lint": "vp lint --type-aware --fix",
		"lint:check": "vp lint --type-aware",
		"changeset:publish": "changeset publish",
		"changeset:version": "changeset version && pnpm format",
		"prepare": "vp config"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@playwright/test": "catalog:",
		"@prettier/plugin-oxc": "catalog:",
		"@svitejs/changesets-changelog-github-compact": "catalog:",
		"@trivago/prettier-plugin-sort-imports": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": "24.x",
		"pnpm": "11.x"
	},
	"packageManager": "pnpm@11.21.0"
}
