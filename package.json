{
	"name": "@skeletonlabs/monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"docs": "pnpm --filter @skeletonlabs/skeleton.dev",
		"themes": "pnpm --filter @skeletonlabs/themes.skeleton.dev",
		"svelte": "pnpm --filter @skeletonlabs/playground-skeleton-svelte",
		"react": "pnpm --filter @skeletonlabs/playground-skeleton-react",
		"test": "vp test run",
		"check": "pnpm --recursive --aggregate-output --reporter=append-only --parallel check",
		"format": "vp fmt . --ignore-unknown",
		"format:check": "vp fmt . --check --ignore-unknown",
		"lint": "vp lint --type-aware --fix",
		"lint:check": "vp lint --type-aware",
		"changeset:publish": "changeset publish",
		"changeset:version": "changeset version && pnpm format",
		"prepare": "vp config"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@playwright/test": "catalog:",
		"@svitejs/changesets-changelog-github-compact": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vite-plus": "catalog:"
	},
	"pnpm": {
		"overrides": {}
	},
	"engines": {
		"node": "24.x",
		"pnpm": "10.30.3"
	},
	"packageManager": "pnpm@10.30.3"
}
